# Placeholders only. Native Codex owns ChatGPT authentication; no OpenAI key here.
# Optional OpenRouter runtime; export real values in your shell, never commit them.
OPENROUTER_API_KEY=<set-in-your-shell>
OPENROUTER_MODEL=<provider/model>
ASTRA_HYPERSPACE_ENDPOINT=<private-local-hyperspace-ip>:50051
PHOTON_SIDECAR_URL=http://127.0.0.1:8790
PHOTON_RECIPIENT_STATE_PATH=<path-to-existing-dispatch-state.json>
# Photon credentials stay in the existing sidecar's supported configuration.
# These illustrative names are required by that existing sidecar, not by this harness:
PHOTON_PROJECT_ID=<configured-by-sidecar-owner>
PHOTON_PROJECT_SECRET=<configured-by-sidecar-owner>
